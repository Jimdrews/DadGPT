# Valgrind suppression file for dad-gpt
# Suppresses known false positives from CUDA runtime libraries.
# Application-level cudaMalloc leaks are NOT suppressed — those are real bugs.

{
   cuda_runtime_init
   Memcheck:Leak
   ...
   obj:*/libcuda.so*
}

{
   cuda_runtime_leak
   Memcheck:Leak
   ...
   obj:*/libcudart.so*
}

{
   cuda_driver_leak
   Memcheck:Leak
   ...
   fun:*cuInit*
}

{
   cuda_device_query
   Memcheck:Leak
   ...
   fun:*cudaGetDeviceCount*
}

# cuBLAS internal allocations during handle creation
{
   cublas_create_leak
   Memcheck:Leak
   ...
   fun:*cublasCreate*
}

# cuRAND internal allocations
{
   curand_init_leak
   Memcheck:Leak
   ...
   fun:*curand*
}

# CUDA lazy initialization (kernel launches, context setup)
{
   cuda_lazy_init
   Memcheck:Leak
   ...
   fun:*cudaLaunchKernel*
}

{
   cuda_stream_init
   Memcheck:Leak
   ...
   fun:*cudaStreamSynchronize*
}
